<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>لوحة التحكم - إدارة بيانات الطلاب | متوسطة الجوادين للبنين</title>
    <link href="https://fonts.googleapis.com/css2?family=Tajawal:wght@400;500;700;800&display=swap" rel="stylesheet">
    <style>
        :root {
            --primary: #1e3a8a;
            --primary-dark: #1e1b4b;
            --bg: #f8fafc;
            --card-bg: #ffffff;
            --text-main: #0f172a;
            --text-muted: #64748b;
            --border: #e2e8f0;
            --danger: #dc2626;
            --success: #16a34a;
        }

        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
            font-family: 'Tajawal', sans-serif;
        }

        body {
            background-color: var(--bg);
            color: var(--text-main);
            padding: 20px;
        }

        .dashboard-container {
            max-width: 1400px;
            margin: 0 auto;
        }

        header {
            background: var(--card-bg);
            padding: 20px 25px;
            border-radius: 12px;
            box-shadow: 0 4px 15px rgba(0, 0, 0, 0.05);
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 25px;
            border: 1px solid var(--border);
        }

        header h1 {
            font-size: 20px;
            color: var(--primary);
            font-weight: 800;
        }

        .stats-bar {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
            gap: 15px;
            margin-bottom: 25px;
        }

        .stat-card {
            background: var(--card-bg);
            padding: 18px;
            border-radius: 10px;
            border: 1px solid var(--border);
            text-align: center;
        }

        .stat-card h3 {
            font-size: 13px;
            color: var(--text-muted);
            margin-bottom: 5px;
        }

        .stat-card p {
            font-size: 22px;
            font-weight: 800;
            color: var(--primary);
        }

        .controls {
            background: var(--card-bg);
            padding: 18px;
            border-radius: 10px;
            border: 1px solid var(--border);
            margin-bottom: 20px;
            display: flex;
            gap: 15px;
            flex-wrap: wrap;
            align-items: center;
        }

        .search-input, .filter-select {
            height: 40px;
            padding: 0 12px;
            border: 1px solid var(--border);
            border-radius: 6px;
            font-size: 14px;
            outline: none;
        }

        .search-input {
            flex-grow: 1;
            min-width: 250px;
        }

        .table-container {
            background: var(--card-bg);
            border-radius: 10px;
            border: 1px solid var(--border);
            overflow-x: auto;
            box-shadow: 0 4px 15px rgba(0, 0, 0, 0.03);
        }

        table {
            width: 100%;
            border-collapse: collapse;
            text-align: right;
            font-size: 13.5px;
        }

        th {
            background-color: #f1f5f9;
            color: var(--primary-dark);
            padding: 12px 15px;
            font-weight: 700;
            border-bottom: 2px solid var(--border);
            white-space: nowrap;
        }

        td {
            padding: 12px 15px;
            border-bottom: 1px solid var(--border);
            white-space: nowrap;
        }

        tr:hover {
            background-color: #f8fafc;
        }

        .badge {
            padding: 4px 8px;
            border-radius: 4px;
            font-size: 12px;
            font-weight: 700;
        }

        .badge-grade {
            background-color: #e0e7ff;
            color: #3730a3;
        }

        .btn-delete {
            background: #fee2e2;
            color: var(--danger);
            border: none;
            padding: 6px 12px;
            border-radius: 4px;
            cursor: pointer;
            font-weight: 700;
            font-size: 12px;
        }

        .btn-delete:hover {
            background: #fca5a5;
        }

        .loading-text {
            text-align: center;
            padding: 30px;
            font-weight: 700;
            color: var(--text-muted);
        }
    </style>
</head>
<body>

    <div class="dashboard-container">
        <header>
            <h1>نظام إدارة بيانات الطلاب - متوسطة الجوادين للبنين</h1>
        </header>

        <div class="stats-bar">
            <div class="stat-card">
                <h3>إجمالي الطلاب المسجلين</h3>
                <p id="totalStudents">0</p>
            </div>
            <div class="stat-card">
                <h3>الصف الأول متوسط</h3>
                <p id="countGrade1">0</p>
            </div>
            <div class="stat-card">
                <h3>الصف الثاني متوسط</h3>
                <p id="countGrade2">0</p>
            </div>
            <div class="stat-card">
                <h3>الصف الثالث متوسط</h3>
                <p id="countGrade3">0</p>
            </div>
        </div>

        <div class="controls">
            <input type="text" id="searchInput" class="search-input" placeholder="بحث باسم الطالب، اسم الأم، أو الرقم الموحد..." oninput="filterData()">
            
            <select id="filterGrade" class="filter-select" onchange="filterData()">
                <option value="">جميع الصفوف</option>
                <option value="الأول متوسط">الأول متوسط</option>
                <option value="الثاني متوسط">الثاني متوسط</option>
                <option value="الثالث متوسط">الثالث متوسط</option>
            </select>

            <select id="filterSection" class="filter-select" onchange="filterData()">
                <option value="">جميع الشعب</option>
                <option value="أ">أ</option>
                <option value="ب">ب</option>
                <option value="ج">ج</option>
                <option value="د">د</option>
                <option value="هـ">هـ</option>
                <option value="و">و</option>
            </select>
        </div>

        <div class="table-container">
            <table>
                <thead>
                    <tr>
                        <th>#</th>
                        <th>اسم الطالب الرباعي</th>
                        <th>اسم الأم الثلاثي</th>
                        <th>الصف والشعبة</th>
                        <th>رقم البطاقة الموحدة</th>
                        <th>تاريخ التولد</th>
                        <th>هاتف ولي الأمر</th>
                        <th>عنوان السكن</th>
                        <th>الإجراءات</th>
                    </tr>
                </thead>
                <tbody id="studentsTableBody">
                    <tr>
                        <td colspan="9" class="loading-text">جاري تحميل البيانات من قاعدة البيانات...</td>
                    </tr>
                </tbody>
            </table>
        </div>
    </div>

    <!-- Firebase SDK -->
    <script src="https://www.gstatic.com/firebasejs/8.10.1/firebase-app.js"></script>
    <script src="https://www.gstatic.com/firebasejs/8.10.1/firebase-database.js"></script>

    <script>
        const firebaseConfig = {
            databaseURL: "https://aljawadindatabase-default-rtdb.firebaseio.com"
        };
        firebase.initializeApp(firebaseConfig);
        const database = firebase.database();

        let allStudents = [];

        // جلب البيانات لحظياً من Firebase
        database.ref('students').on('value', snapshot => {
            allStudents = [];
            const data = snapshot.val();
            
            if (data) {
                for (let id in data) {
                    allStudents.push({ id, ...data[id] });
                }
            }
            updateStats();
            renderTable(allStudents);
        });

        function updateStats() {
            document.getElementById('totalStudents').innerText = allStudents.length;
            document.getElementById('countGrade1').innerText = allStudents.filter(s => s.grade === 'الأول متوسط').length;
            document.getElementById('countGrade2').innerText = allStudents.filter(s => s.grade === 'الثاني متوسط').length;
            document.getElementById('countGrade3').innerText = allStudents.filter(s => s.grade === 'الثالث متوسط').length;
        }

        function renderTable(data) {
            const tbody = document.getElementById('studentsTableBody');
            tbody.innerHTML = '';

            if (data.length === 0) {
                tbody.innerHTML = '<tr><td colspan="9" class="loading-text">لا توجد بيانات مطابقة للبحث.</td></tr>';
                return;
            }

            data.forEach((student, index) => {
                const mahalla = student.address?.mahalla ? `م/${student.address.mahalla}` : '';
                const zuqaq = student.address?.zuqaq ? `ز/${student.address.zuqaq}` : '';
                const dar = student.address?.dar ? `د/${student.address.dar}` : '';
                const fullAddress = `${mahalla} ${zuqaq} ${dar}`.trim() || 'غير محدد';

                const row = document.createElement('tr');
                row.innerHTML = `
                    <td>${index + 1}</td>
                    <td><strong>${student.fullName || ''}</strong></td>
                    <td>${student.motherName || ''}</td>
                    <td><span class="badge badge-grade">${student.grade || ''} - ${student.section || ''}</span></td>
                    <td>${student.nationalId || ''}</td>
                    <td>${student.birthDate || ''}</td>
                    <td>${student.parentPhone || ''}</td>
                    <td>${fullAddress}</td>
                    <td>
                        <button class="btn-delete" onclick="deleteStudent('${student.id}', '${student.fullName}')">حذف</button>
                    </td>
                `;
                tbody.appendChild(row);
            });
        }

        function filterData() {
            const search = document.getElementById('searchInput').value.trim().toLowerCase();
            const selectedGrade = document.getElementById('filterGrade').value;
            const selectedSection = document.getElementById('filterSection').value;

            const filtered = allStudents.filter(s => {
                const matchesSearch = (s.fullName && s.fullName.toLowerCase().includes(search)) ||
                                      (s.motherName && s.motherName.toLowerCase().includes(search)) ||
                                      (s.nationalId && s.nationalId.includes(search));
                
                const matchesGrade = selectedGrade === '' || s.grade === selectedGrade;
                const matchesSection = selectedSection === '' || s.section === selectedSection;

                return matchesSearch && matchesGrade && matchesSection;
            });

            renderTable(filtered);
        }

        function deleteStudent(id, name) {
            if (confirm(`هل أنت تأكد من رغبتك في حذف بيانات الطالب: (${name})؟`)) {
                database.ref('students/' + id).remove().then(() => {
                    alert('تم حذف البيانات بنجاح.');
                }).catch(err => {
                    alert('حدث خطأ أثناء عملية الحذف.');
                });
            }
        }
    </script>
</body>
</html>
